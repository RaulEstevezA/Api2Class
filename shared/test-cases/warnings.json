[
  {
    "description": "values of different types, counted, most frequent first",
    "input": { "rows": [{ "id": 1 }, { "id": "2" }, { "id": 3 }, { "id": null }] },
    "expected": [{ "code": "mixedTypes", "class": "Row", "key": "id", "counts": [["integer", 2], ["string", 1]] }]
  },
  {
    "description": "mixed items of an array",
    "input": { "values": [1, "one", true] },
    "expected": [{ "code": "mixedTypes", "class": "Root", "key": "values", "counts": [["integer", 1], ["string", 1], ["boolean", 1]] }]
  },
  {
    "description": "empty arrays, empty objects and fields that are only null",
    "input": { "warnings": [], "previous": null, "matrix": [[]], "extra": {}, "items": [{ "meta": {} }, { "meta": null }] },
    "expected": [
      { "code": "emptyArray", "class": "Root", "key": "warnings" },
      { "code": "onlyNull", "class": "Root", "key": "previous" },
      { "code": "emptyArray", "class": "Root", "key": "matrix" },
      { "code": "emptyObject", "class": "Root", "key": "extra" },
      { "code": "emptyObject", "class": "Item", "key": "meta" }
    ]
  },
  {
    "description": "integers mixed with floats and nullable fields are not a problem",
    "input": { "rows": [{ "amount": 1, "note": "a" }, { "amount": 2.5, "note": null }] },
    "expected": []
  },
  {
    "description": "a field whose type was set by hand no longer warns",
    "input": { "id": [1, "2"], "previous": null, "address": { "city": "Vinaros" } },
    "edits": { "classes": {}, "fields": { "#/id": { "type": "string" }, "#/previous": { "type": "string" }, "#/address": { "type": "object" } } },
    "expected": []
  }
]
